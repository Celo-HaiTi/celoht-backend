{
  "name": "celoht-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Official CeloHT application backend: API, wallet authentication, authorization, admin workflows.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "integration": "npm run smoke",
    "smoke": "node scripts/smoke.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "mock-data-guard": "node scripts/mock-data-guard.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "next": "^16.3.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "viem": "^2.21.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.9",
    "typescript": "5.5.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
