# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Blockchain configuration ----
# Must match the officially deployed network. Backend fails closed if unset
# or if it does not match a known CeloHT deployment.
CELO_NETWORK=celoSepolia
CELO_CHAIN_ID=11142220
CELO_RPC_URL=https://forno.celo-sepolia.celo-testnet.org
CELO_CONFIRMATIONS=1
CELO_BACKFILL_BLOCKS=0
CELO_POLL_INTERVAL_MS=10000
CELO_RPC_RETRIES=3
CELO_RPC_TIMEOUT_MS=5000

# ---- Auth ----
# Random 32+ byte secret used to sign short-lived session/challenge tokens.
AUTH_SESSION_SECRET=
AUTH_NONCE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=86400

# ---- Shared rate limiting (required in production) ----
# Upstash Redis REST credentials. Leave unset for local development only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- App ----
NODE_ENV=development
CELOHT_ALLOWED_ORIGIN=
