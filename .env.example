# ---- Supabase ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Blockchain configuration ----
# Must match the officially deployed network. Backend fails closed if unset
# or if it does not match a known CeloHT deployment.
CELO_CHAIN_ID=11142220
CELO_RPC_URL=

# ---- Auth ----
# Random 32+ byte secret used to sign short-lived session/challenge tokens.
AUTH_SESSION_SECRET=
AUTH_NONCE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=86400

# ---- App ----
NODE_ENV=development
CELOHT_ALLOWED_ORIGIN=
